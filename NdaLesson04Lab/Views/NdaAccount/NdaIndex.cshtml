
@{
    ViewData["Title"] = "Danh sachs tài khoản";
    var NdaAccount = ViewBag.NdaAccount;
}

<div class="row">
    @foreach (NdaAccount item in NdaAccount)
    {
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="img">
                        <img src="@item.Avatar" alt="@item.Name" class="w-100" />
                </div>
                <div class="">
                    <h3>@item.Name</h3>
                    <p>@item.Bio</p>
                    <a asp-route="NdaProfile" asp-route-id="@item.Id" class="btn btn-success btn-block">Profile</a>
                </div>
            </div>
        </div>
    </div>}
</div>

@{
    ViewData["Title"] = "Cú pháp razorcode";
    
}
<h1>@ViewData["Title"]</h1>
<hr />
@{
    var total = 7500;
    var myMessage = "Bạn nhiểu tiền thế";

}
<p>Tài khoản của bạn bằng: $ @total</p>
<p>@myMessage</p>

<h2>Cấu trúc if</h2>
<hr />
    @if (total> 5000){
        <p>Bạn là người giàu có</p>
    }
    else if (total > 2000){
        <p>Bạn là người khá giả</p>
    }
    else{
        <p>Bạn là bình thường</p>
    }
<h2>Cấu trúc lập for(....)</h2>

@for(int i=0; i<10; i++){
    if(i%2==0){
        <Span class="btn btn-danger">@i</Span>
    }
    else
    {
        <Span class="btn btn-success">@i</Span>
    }
}
<h2>Mảng</h2>
@{
    string[] myArray = { "icon1.png", "icon2.png", "icon3.png", "icon4.png" ,"icon5.png"};
}
@foreach (var item in myArray){
    <img src="~/images/@item" width="150px" height="150px" />
}
)
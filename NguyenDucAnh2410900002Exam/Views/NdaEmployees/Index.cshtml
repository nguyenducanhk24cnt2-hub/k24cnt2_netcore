@model IEnumerable<NguyenDucAnh2410900002Exam.Models.NdaEmployee>

@{
    ViewData["Title"] = "Danh sách nhân viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2 text-primary fw-bold">@ViewData["Title"]</h1>
        <p class="mb-0">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-lg"></i> Tạo Mới
            </a>
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Id)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NdaName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NdaGender)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NdaBirthDay)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NdaEmail)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NdaPhone)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.NdaActive)
                            </th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(model => item.Id)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.NdaName)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.NdaGender)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.NdaBirthDay)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.NdaEmail)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.NdaPhone)
                                </td>
                                <td>
                                    @if (item.NdaActive)
                                    {
                                        <span class="badge bg-success">Còn Hoạt Động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Đã Dừng Hoạt Động</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Sửa</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Thông tin</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
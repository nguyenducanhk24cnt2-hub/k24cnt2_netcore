@model NguyenDucAnh2410900002Exam.Models.NdaEmployee

@{
    ViewData["Title"] = "Chi tiết";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 col-md-8 mx-auto">
        <div class="card-header bg-primary text-white py-3">
            <h1 class="h4 mb-0 text-white"><i class="bi bi-person-lines-fill"></i> @ViewData["Title"]</h1>
        </div>
        <div class="card-body p-4">
            
            <dl class="row mb-2">
                <dt class="col-sm-3 text-secondary fw-bold">
                    @Html.DisplayNameFor(model => model.Id)
                </dt>
                <dd class="col-sm-9 fw-semibold">
                    @Html.DisplayFor(model => model.Id)
                </dd>
            </dl>
            <hr class="text-muted my-2" />
            <dl class="row mb-2">
                <dt class="col-sm-3 text-secondary fw-bold">
                    @Html.DisplayNameFor(model => model.NdaName)
                </dt>
                <dd class="col-sm-9 fw-semibold">
                    @Html.DisplayFor(model => model.NdaName)
                </dd>
            </dl>
            <hr class="text-muted my-2" />

            <dl class="row mb-2">
                <dt class="col-sm-3 text-secondary fw-bold">
                    @Html.DisplayNameFor(model => model.NdaGender)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NdaGender)
                </dd>
            </dl>
            <hr class="text-muted my-2" />

            <dl class="row mb-2">
                <dt class="col-sm-3 text-secondary fw-bold">
                    @Html.DisplayNameFor(model => model.NdaBirthDay)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NdaBirthDay)
                </dd>
            </dl>
            <hr class="text-muted my-2" />

            <dl class="row mb-2">
                <dt class="col-sm-3 text-secondary fw-bold">
                    @Html.DisplayNameFor(model => model.NdaEmail)
                </dt>
                <dd class="col-sm-9 text-primary">
                    @Html.DisplayFor(model => model.NdaEmail)
                </dd>
            </dl>
            <hr class="text-muted my-2" />

            <dl class="row mb-2">
                <dt class="col-sm-3 text-secondary fw-bold">
                    @Html.DisplayNameFor(model => model.NdaPhone)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NdaPhone)
                </dd>
            </dl>
            <hr class="text-muted my-2" />

            <dl class="row mb-3">
                <dt class="col-sm-3 text-secondary fw-bold">
                    @Html.DisplayNameFor(model => model.NdaActive)
                </dt>
                <dd class="col-sm-9">
                    @if (Model.NdaActive)
                    {
                        <span class="badge bg-success">Đang Hoạt Động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Đã Ngừng Hoạt Động</span>
                    }
                </dd>
            </dl>

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Về Danh Sách
                </a>
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4">
                    <i class="bi bi-pencil-square"></i> Sửa
                </a>
            </div>
        </div>
    </div>
</div>
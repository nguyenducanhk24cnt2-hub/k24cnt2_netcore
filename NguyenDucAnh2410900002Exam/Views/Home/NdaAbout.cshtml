@{
    ViewData["Title"] = "Thông tin sinh viên";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white py-3">
            <h1 class="h3 mb-0 text-white">@ViewData["Title"]</h1>
        </div>
        <div class="card-body p-4 fs-5">
            <div class="row mb-2">
                <div class="col-sm-3 fw-bold text-secondary">Mã sinh viên:</div>
                <div class="col-sm-9 text-dark">@ViewBag.MaSV</div>
            </div>
            <hr class="text-muted my-2" />

            <div class="row mb-2">
                <div class="col-sm-3 fw-bold text-secondary">Họ và tên:</div>
                <div class="col-sm-9 text-dark fw-semibold">@ViewBag.HoTen</div>
            </div>
            <hr class="text-muted my-2" />

            <div class="row mb-2">
                <div class="col-sm-3 fw-bold text-secondary">Lớp:</div>
                <div class="col-sm-9 text-dark">@ViewBag.Lop</div>
            </div>
            <hr class="text-muted my-2" />

            <div class="row mb-2">
                <div class="col-sm-3 fw-bold text-secondary">Ngày sinh:</div>
                <div class="col-sm-9 text-dark">@ViewBag.NgaySinh</div>
            </div>
            <hr class="text-muted my-2" />

            <div class="row mb-2">
                <div class="col-sm-3 fw-bold text-secondary">Email:</div>
                <div class="col-sm-9 text-primary">@ViewBag.Email</div>
            </div>
        </div>
    </div>
</div>
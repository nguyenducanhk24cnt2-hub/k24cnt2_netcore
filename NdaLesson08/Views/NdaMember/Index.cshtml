@model IEnumerable<NdaLesson08.Models.NdaMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}
<div class="card p-3">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="NdaCreate">Them moi</a>
    </div>
   
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.NdaMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NdaUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NdaPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NdaFullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NdaEmail)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.NdaMemberId)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.NdaUserName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.NdaPassword)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.NdaFullName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.NdaEmail)
                    </td>
                    <td>
                        @Html.ActionLink("Sửa", "NdaEdit", new { id = item.NdaMemberId }) |
                        @Html.ActionLink("Xem chi tiết", "NdaDetails", new { id = item.NdaMemberId }) |
                        @Html.ActionLink("Delete", "NdaDelete", new { id = item.NdaMemberId })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

